<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_15"
            android:padding="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_10"
            android:text="Add Countdown"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:background="@drawable/bg_rounded_button"
            android:backgroundTint="@color/colorPrimary"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constraintToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.starter.app.utils.ProgressCircleView
                android:id="@+id/progressViewUser"
                android:layout_width="@dimen/dp_125"
                android:layout_height="@dimen/dp_125"
                android:layout_marginVertical="@dimen/dp_15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardViewPreview">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputDate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputDate"
                app:srcCompat="@drawable/ic_calendar" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputDate"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="@id/textInputCountFor"
                app:layout_constraintStart_toStartOf="@id/textInputCountFor"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditTextDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="@string/label_select_a_date"
                    android:inputType="none"
                    android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputTime"
                app:srcCompat="@drawable/ic_clock" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputTime"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="@id/textInputDate"
                app:layout_constraintStart_toStartOf="@id/textInputDate"
                app:layout_constraintTop_toBottomOf="@id/textInputDate">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="Time"
                    android:inputType="none"
                    android:textColor="@color/dark_gray" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivRecurrence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputRecurrence"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputRecurrence"
                app:srcCompat="@drawable/ic_repeat" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputRecurrence"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="@id/textInputTime"
                app:layout_constraintStart_toStartOf="@id/textInputTime"
                app:layout_constraintTop_toBottomOf="@id/textInputTime">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecurrence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="Recurrence"
                    android:inputType="none"
                    android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textViewNextRecurrence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="Next recurrence: 08/10/25 16:30"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/textInputRecurrence"
                app:layout_constraintTop_toBottomOf="@id/textInputRecurrence" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBookmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputWhatIsOnThatDay"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputWhatIsOnThatDay"
                app:srcCompat="@drawable/ic_tag" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputWhatIsOnThatDay"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivBookmark"
                app:layout_constraintTop_toBottomOf="@id/textInputRecurrence">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWhatIsOnThatDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_what_is_on_that_day"
                    android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputYourNotes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputYourNotes"
                app:srcCompat="@drawable/ic_note" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputYourNotes"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintEnd_toEndOf="@id/textInputWhatIsOnThatDay"
                app:layout_constraintStart_toStartOf="@id/textInputWhatIsOnThatDay"
                app:layout_constraintTop_toBottomOf="@id/textInputWhatIsOnThatDay">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etYourNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_your_notes"
                    android:textColor="@color/dark_gray" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivPalette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textInputYourNotes"
                app:srcCompat="@drawable/ic_palette" />

            <LinearLayout
                android:id="@+id/colorCirclesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/ivPalette"
                app:layout_constraintStart_toEndOf="@id/ivPalette"
                app:layout_constraintTop_toTopOf="@id/ivPalette">

                <View
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:background="@drawable/bg_round_ciricle"
                    android:backgroundTint="@color/blue" />

                <View
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/bg_round_ciricle"
                    android:backgroundTint="@color/gray" />

                <View
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/bg_round_ciricle" />

                <View
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/bg_round_ciricle"
                    android:backgroundTint="@color/black" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="@color/colorPrimary"
                android:text="Theme"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="@id/colorCirclesLayout"
                app:layout_constraintTop_toBottomOf="@id/colorCirclesLayout" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCountFor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputCountFor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputCountFor"
                app:srcCompat="@drawable/ic_filter" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputCountFor"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintEnd_toEndOf="@id/textInputYourNotes"
                app:layout_constraintStart_toStartOf="@id/textInputYourNotes"
                app:layout_constraintTop_toBottomOf="@id/btnSelectTheme">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextCountFor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_count_for"
                    android:textColor="@color/dark_gray" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="Show label"
                android:textColor="@color/dark_gray"
                android:textSize="@dimen/sp_16"
                app:layout_constraintStart_toStartOf="@id/textInputCountFor"
                app:layout_constraintTop_toBottomOf="@id/textInputCountFor"
                app:switchPadding="@dimen/dp_10" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/switchTime"
                app:layout_constraintEnd_toStartOf="@id/switchTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/switchTime"
                app:srcCompat="@drawable/ic_remain" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="Decrease circle with time"
                android:textColor="@color/dark_gray"
                android:textSize="@dimen/sp_16"
                app:layout_constraintStart_toStartOf="@id/switchLabel"
                app:layout_constraintTop_toBottomOf="@id/switchLabel"
                app:switchPadding="@dimen/dp_10" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputDecrease"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintEnd_toEndOf="@id/textInputYourNotes"
                app:layout_constraintStart_toStartOf="@id/textInputYourNotes"
                app:layout_constraintTop_toBottomOf="@id/switchTime">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextDecrease"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="When Should the circle start decrease?"
                    android:textColor="@color/dark_gray" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@id/textInputFont"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textInputFont"
                app:srcCompat="@drawable/ic_font" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputFont"
                style="@style/BoxEditText"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintEnd_toEndOf="@id/textInputYourNotes"
                app:layout_constraintStart_toStartOf="@id/textInputYourNotes"
                app:layout_constraintTop_toBottomOf="@id/textInputDecrease">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextFont"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Font"
                    android:textColor="@color/dark_gray" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/switchDropShadow"
                app:layout_constraintEnd_toStartOf="@id/switchDropShadow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/switchDropShadow"
                app:srcCompat="@drawable/ic_drop_shadow" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDropShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="Drop shadow"
                android:textColor="@color/dark_gray"
                android:textSize="@dimen/sp_16"
                app:layout_constraintStart_toStartOf="@id/switchLabel"
                app:layout_constraintTop_toBottomOf="@id/textInputFont"
                app:switchPadding="@dimen/dp_10" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/switchClockWise"
                app:layout_constraintEnd_toStartOf="@id/switchClockWise"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/switchClockWise"
                app:srcCompat="@drawable/ic_anti_clock" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchClockWise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_30"
                android:text="clockwise"
                android:textColor="@color/dark_gray"
                android:textSize="@dimen/sp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/switchLabel"
                app:layout_constraintTop_toBottomOf="@id/switchDropShadow"
                app:switchPadding="@dimen/dp_10" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>